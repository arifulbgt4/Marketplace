generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  user
  admin
  support
  catalog_manager
}

enum UserStatus {
  active
  suspended
  pending_verification
}

enum ListingStatus {
  draft
  published
  archived
}

enum ListingType {
  rent
  sale
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  completed
}

enum DiscountType {
  percentage
  fixed
}

enum CouponScope {
  all
  category
  product
}

enum CheckoutSessionStatus {
  active
  expired
  completed
}

enum AddressType {
  shipping
  billing
}

enum PaymentStatus {
  UNPAID
  PENDING
  PENDING_COLLECTION
  PAID
  COLLECTED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ProductStatus {
  draft
  published
  archived
}

enum InventoryEntryType {
  reservation
  commit
  release
  adjustment
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ResourceReleaseType {
  INVENTORY
  COUPON
}

enum OrderTransitionKind {
  ORDER
  FULFILLMENT
}

enum ContentSectionStatus {
  draft
  published
  archived
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  FLAGGED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportRequestSource {
  CONTACT
  LISTING_REPORT
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  password       String
  role           UserRole   @default(user)
  status         UserStatus @default(pending_verification)
  sessionVersion Int        @default(0)
  image          String?
  phone          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  Account                 Account?
  listings                Listing[]
  orders                  Order[]
  reviewsWritten          Review[]                @relation("ReviewAuthor")
  sentMessages            Message[]               @relation("MessageSender")
  receivedMessages        Message[]               @relation("MessageReceiver")
  bookmarks               Bookmark[]
  media                   UserMedia[]
  addresses               Address[]
  auditLogs               AuditLog[]
  resetTokens             ResetToken[]
  verificationTokens      VerificationToken[]
  products                Product[]
  inventoryLedger         InventoryLedger[]
  carts                   Cart[]
  checkoutSessions        CheckoutSession[]
  couponUsages            CouponUsage[]
  idempotencyKeys         IdempotencyKey[]
  orderStatusChanges      OrderStatusHistory[]    @relation("OrderStatusHistoryActor")
  returnRequests          ReturnRequest[]         @relation("ReturnRequestedBy")
  contentSectionsEdited   ContentSection[]        @relation("ContentSectionEditor")
  reviewsModerated        Review[]                @relation("ReviewModerator")
  productWishlistItems    ProductWishlistItem[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  supportRequests         SupportRequest[]        @relation("SupportRequestOwner")
  assignedSupportRequests SupportRequest[]        @relation("SupportRequestAssignee")
}

model Account {
  id     String  @id @default(uuid())
  bio    String?
  phone  String?
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserMedia {
  id        String   @id @default(uuid())
  url       String
  type      String   @default("image")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  icon         String?
  image        String?
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  listings     Listing[]
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String
  price       Decimal
  discount    Decimal?
  status      ListingStatus @default(draft)
  type        ListingType   @default(rent)
  images      String[]
  address     String
  latitude    Float?
  longitude   Float?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  amenities   String[]
  maxGuests   Int?
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  orders      Order[]
  reviews     Review[]
  bookmarks   Bookmark[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([userId])
}

model Product {
  id              String                @id @default(uuid())
  name            String
  slug            String                @unique
  description     String
  status          ProductStatus         @default(draft)
  brand           String?
  taxClass        String?
  categoryId      String?
  category        Category?             @relation(fields: [categoryId], references: [id])
  legacyListingId String?
  createdById     String
  createdBy       User                  @relation(fields: [createdById], references: [id])
  variants        ProductVariant[]
  options         ProductOption[]
  media           ProductMedia[]
  reviews         Review[]
  wishlistItems   ProductWishlistItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([slug])
}

model ProductVariant {
  id             String            @id @default(uuid())
  sku            String            @unique
  barcode        String?
  price          Decimal
  compareAtPrice Decimal?
  weightGrams    Int               @default(0)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  ledgerEntries  InventoryLedger[]
  cartItems      CartItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([sku])
  @@index([productId])
}

model ProductOption {
  id        String   @id @default(uuid())
  name      String
  values    Json     @default("[]")
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, isPrimary])
}

model Inventory {
  id                String         @id @default(uuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([variantId])
}

model InventoryLedger {
  id            String             @id @default(uuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  entryType     InventoryEntryType
  quantity      Int
  reason        String
  referenceId   String?
  referenceType String?
  actorId       String
  actor         User               @relation(fields: [actorId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([variantId])
  @@index([actorId])
  @@index([referenceType, referenceId])
}

model Order {
  id                      String               @id @default(uuid())
  orderNo                 String               @unique
  status                  OrderStatus          @default(pending)
  statusVersion           Int                  @default(0)
  startDate               DateTime?
  endDate                 DateTime?
  totalPrice              Decimal
  subtotal                Decimal?
  shippingCost            Decimal?
  discountAmount          Decimal?
  guests                  Int                  @default(1)
  userId                  String
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId               String?
  listing                 Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  couponId                String?
  coupon                  Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryMethodId        String?
  deliveryMethod          DeliveryMethod?      @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  currency                String               @default("USD")
  notes                   String?
  paymentMethod           String?
  shippingAddressSnapshot Json?
  idempotencyKey          String?              @unique
  placedAt                DateTime?
  items                   OrderItem[]
  paymentStatus           PaymentStatus        @default(UNPAID)
  fulfillmentStatus       FulfillmentStatus    @default(UNFULFILLED)
  payments                Payment[]
  statusHistory           OrderStatusHistory[]
  shipments               Shipment[]
  returnRequests          ReturnRequest[]
  resourceReleases        ResourceRelease[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@index([idempotencyKey])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  productId     String?
  sku           String
  productName   String
  unitPrice     Decimal
  quantity      Int
  totalPrice    Decimal
  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  review        Review?

  @@index([orderId])
}

model OrderStatusHistory {
  id                    String              @id @default(uuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence              Int
  kind                  OrderTransitionKind
  fromOrderStatus       OrderStatus?
  toOrderStatus         OrderStatus?
  fromFulfillmentStatus FulfillmentStatus?
  toFulfillmentStatus   FulfillmentStatus?
  actorId               String?
  actor                 User?               @relation("OrderStatusHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason                String?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now())

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
  @@index([orderId, kind])
  @@index([actorId])
}

model Shipment {
  id                  String         @id @default(uuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status              ShipmentStatus @default(PENDING)
  carrier             String?
  service             String?
  trackingNumber      String?
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  metadata            Json           @default("{}")
  items               ShipmentItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String    @id @default(uuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ReturnRequest {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?        @relation("ReturnRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  status         ReturnStatus @default(REQUESTED)
  reason         String
  resolutionNote String?
  refundAmount   Decimal?
  currency       String?
  approvedAt     DateTime?
  receivedAt     DateTime?
  completedAt    DateTime?
  items          ReturnItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  reason          String?
  condition       String?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ResourceRelease {
  id             String              @id @default(uuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           ResourceReleaseType
  resourceId     String
  quantity       Int?
  idempotencyKey String              @unique
  metadata       Json                @default("{}")
  releasedAt     DateTime            @default(now())

  @@index([orderId])
  @@index([type, resourceId])
}

model Cart {
  id               String            @id @default(uuid())
  userId           String?           @unique
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken     String?           @unique
  currency         String            @default("USD")
  subtotal         Decimal           @default(0)
  version          Int               @default(1)
  expiresAt        DateTime?
  items            CartItem[]
  checkoutSessions CheckoutSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id          String         @id @default(uuid())
  cartId      String
  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId   String
  sku         String
  productName String
  imageUrl    String?
  unitPrice   Decimal
  quantity    Int
  createdAt   DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model CheckoutSession {
  id                String                @id @default(uuid())
  cartId            String
  cart              Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartVersion       Int
  userId            String?
  user              User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            CheckoutSessionStatus @default(active)
  subtotal          Decimal               @default(0)
  discountAmount    Decimal               @default(0)
  shippingCost      Decimal               @default(0)
  totalAmount       Decimal               @default(0)
  currency          String                @default("USD")
  couponId          String?
  coupon            Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryMethodId  String?
  deliveryMethod    DeliveryMethod?       @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  shippingAddressId String?
  shippingAddress   Address?              @relation("CheckoutShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?
  billingAddress    Address?              @relation("CheckoutBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  expiresAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([cartId])
  @@index([userId])
}

model DeliveryZone {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  countries   String[]
  regions     String[]
  postalCodes String[]
  isActive    Boolean          @default(true)
  priority    Int              @default(0)
  methods     DeliveryMethod[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, priority])
}

model DeliveryMethod {
  id                String            @id @default(uuid())
  zoneId            String
  zone              DeliveryZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name              String
  code              String
  carrier           String?
  price             Decimal
  freeShippingAbove Decimal?
  minWeightGrams    Int?
  maxWeightGrams    Int?
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  isActive          Boolean           @default(true)
  checkoutSessions  CheckoutSession[]
  orders            Order[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId, isActive])
}

model Coupon {
  id                String            @id @default(uuid())
  code              String            @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal
  minOrderAmount    Decimal?
  maxDiscountAmount Decimal?
  scope             CouponScope       @default(all)
  scopeIds          Json              @default("[]")
  usageLimit        Int?
  usagePerUser      Int?
  usedCount         Int               @default(0)
  isActive          Boolean           @default(true)
  startsAt          DateTime?
  expiresAt         DateTime?
  usages            CouponUsage[]
  checkoutSessions  CheckoutSession[]
  orders            Order[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id            String    @id @default(uuid())
  couponId      String
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId       String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt        DateTime  @default(now())
  releasedAt    DateTime?
  releaseReason String?

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([orderId])
  @@index([userId])
  @@index([couponId, releasedAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  Json
  createdAt DateTime @default(now())

  @@index([key])
  @@index([userId])
}

model Review {
  id               String       @id @default(uuid())
  rating           Float
  cleanliness      Float?
  communication    Float?
  checkIn          Float?
  accuracy         Float?
  location         Float?
  value            Float?
  comment          String?
  userId           String
  author           User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  listingId        String?
  listing          Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId      String?      @unique
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(APPROVED)
  moderatedById    String?
  moderatedBy      User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationNote   String?
  moderatedAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, listingId])
  @@unique([userId, productId])
  @@index([listingId])
  @@index([productId, status])
  @@index([userId, status])
  @@index([moderatedById])
}

model ContentSection {
  id           String               @id @default(uuid())
  sectionKey   String
  sectionType  String
  locale       String               @default("en")
  status       ContentSectionStatus @default(draft)
  displayOrder Int                  @default(0)
  isVisible    Boolean              @default(true)
  content      Json                 @default("{}")
  revision     Int                  @default(1)
  editorId     String?
  editor       User?                @relation("ContentSectionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([sectionKey, locale, revision])
  @@index([status, isVisible, displayOrder])
  @@index([sectionType])
  @@index([editorId])
}

model ProductWishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEventId String?   @unique
  type          String
  title         String
  message       String
  data          Json      @default("{}")
  readAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@index([expiresAt])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailTransactional Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  inAppTransactional Boolean  @default(true)
  inAppMarketing     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupportRequest {
  id           String                 @id @default(uuid())
  reference    String                 @unique
  ownerId      String?
  owner        User?                  @relation("SupportRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?                  @relation("SupportRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  source       SupportRequestSource
  status       SupportRequestStatus   @default(OPEN)
  priority     SupportRequestPriority @default(NORMAL)
  name         String
  email        String
  phone        String?
  subject      String
  message      String
  context      Json                   @default("{}")
  internalNote String?
  version      Int                    @default(1)
  resolvedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, priority, createdAt])
  @@index([source, createdAt])
  @@index([ownerId, createdAt])
  @@index([assignedToId, status])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  read       Boolean  @default(false)
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Address {
  id                       String            @id @default(uuid())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                     AddressType       @default(shipping)
  label                    String            @default("")
  line1                    String
  line2                    String?
  city                     String
  state                    String
  postalCode               String
  country                  String
  phone                    String?
  isDefault                Boolean           @default(false)
  shippingCheckoutSessions CheckoutSession[] @relation("CheckoutShippingAddress")
  billingCheckoutSessions  CheckoutSession[] @relation("CheckoutBillingAddress")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

model ResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Decimal
  refundedAmount Decimal        @default(0)
  currency       String
  status         PaymentStatus  @default(PENDING)
  provider       String
  providerRef    String?        @unique
  attempts       Int            @default(1)
  events         PaymentEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerRef])
}

model PaymentEvent {
  id             String        @id @default(uuid())
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  idempotencyKey String?       @unique
  type           String
  statusFrom     PaymentStatus
  statusTo       PaymentStatus
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([paymentId])
  @@index([paymentId, type])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  publishedAt    DateTime?
  lastError      String?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
}

model BusinessSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
