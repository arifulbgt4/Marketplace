generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  user
  admin
  support
  catalog_manager
}

enum UserStatus {
  active
  suspended
  pending_verification
}

enum ListingStatus {
  draft
  published
  archived
}

enum ListingType {
  rent
  sale
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  completed
}

enum DiscountType {
  percentage
  fixed
}

enum CouponScope {
  all
  category
  product
}

enum CheckoutSessionStatus {
  active
  expired
  completed
}

enum AddressType {
  shipping
  billing
}

enum ProductStatus {
  draft
  published
  archived
}

enum InventoryEntryType {
  reservation
  commit
  release
  adjustment
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      UserRole   @default(user)
  status    UserStatus @default(pending_verification)
  image     String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  Account          Account?
  listings         Listing[]
  orders           Order[]
  reviewsWritten   Review[]      @relation("ReviewAuthor")
  sentMessages     Message[]     @relation("MessageSender")
  receivedMessages Message[]     @relation("MessageReceiver")
  bookmarks        Bookmark[]
  media            UserMedia[]
  addresses        Address[]
  auditLogs        AuditLog[]
  resetTokens      ResetToken[]
  verificationTokens VerificationToken[]
  products         Product[]
  inventoryLedger  InventoryLedger[]
}

model Account {
  id     String  @id @default(uuid())
  bio    String?
  phone  String?
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserMedia {
  id        String   @id @default(uuid())
  url       String
  type      String   @default("image")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id           String       @id @default(uuid())
  name         String       @unique
  slug         String       @unique
  icon         String?
  image        String?
  parentId     String?
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  listings     Listing[]
  products     Product[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Listing {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String
  price       Float
  discount    Float?
  status      ListingStatus @default(draft)
  type        ListingType   @default(rent)
  images      String[]
  address     String
  latitude    Float?
  longitude   Float?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  amenities   String[]
  maxGuests   Int?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  orders      Order[]
  reviews     Review[]
  bookmarks   Bookmark[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([userId])
}

model Product {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String
  status          ProductStatus @default(draft)
  brand           String?
  taxClass        String?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  legacyListingId String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  variants        ProductVariant[]
  options         ProductOption[]
  media           ProductMedia[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([slug])
}

model ProductVariant {
  id             String           @id @default(uuid())
  sku            String           @unique
  barcode        String?
  price          Decimal
  compareAtPrice Decimal?
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  ledgerEntries  InventoryLedger[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([sku])
  @@index([productId])
}

model ProductOption {
  id        String   @id @default(uuid())
  name      String
  values    Json     @default("[]")
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id               String   @id @default(uuid())
  variantId        String   @unique
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand           Int      @default(0)
  reserved         Int      @default(0)
  lowStockThreshold Int     @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([variantId])
}

model InventoryLedger {
  id            String             @id @default(uuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  entryType     InventoryEntryType
  quantity      Int
  reason        String
  referenceId   String?
  referenceType String?
  actorId       String
  actor         User               @relation(fields: [actorId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([variantId])
  @@index([actorId])
  @@index([referenceType, referenceId])
}

model Order {
  id          String      @id @default(uuid())
  orderNo     String      @unique
  status      OrderStatus @default(pending)
  startDate   DateTime?
  endDate     DateTime?
  totalPrice  Float
  subtotal    Float?
  shippingCost Float?
  discountAmount Float?
  guests      Int         @default(1)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  couponId    String?
  deliveryMethodId String?
  currency    String      @default("USD")
  notes       String?
  paymentMethod String?
  shippingAddressSnapshot Json?
  idempotencyKey String?  @unique
  placedAt    DateTime?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@index([idempotencyKey])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  productId   String?
  sku         String
  productName String
  unitPrice   Decimal
  quantity    Int
  totalPrice  Decimal

  @@index([orderId])
}

model Cart {
  id         String      @id @default(uuid())
  userId     String?
  sessionToken String?
  currency   String      @default("USD")
  subtotal   Float       @default(0)
  expiresAt  DateTime?
  items      CartItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  productId String
  sku       String
  productName String
  imageUrl  String?
  unitPrice Decimal
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model CheckoutSession {
  id             String                @id @default(uuid())
  cartId         String
  userId         String?
  status         CheckoutSessionStatus @default(active)
  subtotal       Float                 @default(0)
  discountAmount Float                 @default(0)
  shippingCost   Float                 @default(0)
  totalAmount    Float                 @default(0)
  currency       String                @default("USD")
  couponId       String?
  deliveryMethodId String?
  shippingAddressId String?
  billingAddressId  String?
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([cartId])
  @@index([userId])
}

model DeliveryZone {
  id         String            @id @default(uuid())
  name       String
  slug       String            @unique
  countries  String[]
  regions    String[]
  postalCodes String[]
  isActive   Boolean           @default(true)
  priority   Int               @default(0)
  methods    DeliveryMethod[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([isActive, priority])
}

model DeliveryMethod {
  id               String        @id @default(uuid())
  zoneId           String
  zone             DeliveryZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name             String
  code             String
  carrier          String?
  price            Decimal
  freeShippingAbove Decimal?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([zoneId, isActive])
}

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal
  minOrderAmount  Decimal?
  maxDiscountAmount Decimal?
  scope           CouponScope  @default(all)
  scopeIds        Json         @default("[]")
  usageLimit      Int?
  usagePerUser    Int?
  usedCount       Int          @default(0)
  isActive        Boolean      @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  usages          CouponUsage[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId  String?
  userId   String
  usedAt   DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([userId])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  response  Json
  createdAt DateTime @default(now())

  @@index([key])
}

model Review {
  id            String   @id @default(uuid())
  rating        Float
  cleanliness   Float?
  communication Float?
  checkIn       Float?
  accuracy      Float?
  location      Float?
  value         Float?
  comment       String?
  userId        String
  author        User     @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([listingId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  read       Boolean  @default(false)
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Address {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType @default(shipping)
  label      String      @default("")
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

model ResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
